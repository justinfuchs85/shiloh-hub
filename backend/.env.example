# Copy this file to .env and fill in your values

# Database — SQLite file path (no external DB needed)
DATABASE_URI=file:./shiloh-hub.db

# Payload secret — change this to a long random string in production
PAYLOAD_SECRET=shiloh-secret-change-me-in-production

# Frontend URL — for CORS
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5173

# Server URL — used in admin panel links
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
